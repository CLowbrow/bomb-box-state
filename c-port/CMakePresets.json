{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "GAME_RULES_C_BUILD_EXAMPLES": "ON",
        "GAME_RULES_C_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native debug, strict C17",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native release, strict C17",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-sanitized",
      "displayName": "Native debug with ASan and UBSan",
      "inherits": "native-debug",
      "cacheVariables": {
        "GAME_RULES_C_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly debug (run through emcmake)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly release (run through emcmake)",
      "inherits": "wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "native-sanitized", "configurePreset": "native-sanitized" },
    { "name": "wasm-debug", "configurePreset": "wasm-debug" },
    { "name": "wasm-release", "configurePreset": "wasm-release" }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "native-sanitized",
      "configurePreset": "native-sanitized",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}

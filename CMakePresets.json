{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BOMB_BOX_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BOMB_BOX_BUILD_WASM": "OFF"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BOMB_BOX_BUILD_WASM": "OFF"
      }
    },
    {
      "name": "native-sanitized",
      "displayName": "Native debug with sanitizers",
      "inherits": "native-debug",
      "cacheVariables": {
        "BOMB_BOX_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly debug (run through emcmake)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BOMB_BOX_BUILD_WASM": "ON"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly release (run through emcmake)",
      "inherits": "wasm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-sanitized",
      "configurePreset": "native-sanitized"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-sanitized",
      "configurePreset": "native-sanitized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

